
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--page-width
    color-{{ section.settings.color_scheme }}
    section-bestsellers
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
  "
>
  <div class="bestsellers__header">
    {% if section.settings.heading != blank %}
      <div class="bestsellers__heading rte">
        {{ section.settings.heading }}
      </div>
    {% endif %}
    <hr class="bestsellers__divider">
  </div>

  {% content_for 'block', type: '_carousel-content', id: 'static-bestsellers-carousel', closest.product: null %}

  <div class="bestsellers__footer">
    <hr class="bestsellers__divider">
    {% if section.settings.button_text != blank %}
      <div class="bestsellers__button-wrapper">
        <a
          {% if section.settings.button_url != blank %}href="{{ section.settings.button_url }}"{% endif %}
          class="bestsellers__button"
        >
          {{ section.settings.button_text | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .section-bestsellers {
    display: grid;
    grid-template-columns: var(--full-page-grid-with-margins);
  }

  .section-bestsellers > * {
    grid-column: 2;
  }

  .section-bestsellers > .force-full-width {
    grid-column: 1 / -1;
  }

  /* Header */
  .bestsellers__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .bestsellers__heading {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 48px;
    line-height: 52px;
    color: #767676;
  }

  .bestsellers__heading strong {
    color: var(--color-foreground-heading);
  }

  .bestsellers__heading p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .bestsellers__heading {
      font-size: 36px;
      line-height: 40px;
    }
  }

  /* Divider */
  .bestsellers__divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
    width: 100%;
  }

  /* Card overrides */
  .section-bestsellers .card {
    border-radius: 16px;
    overflow: hidden;
    background: #FFFFFF;
  }

  @media screen and (min-width: 750px) {
    .section-bestsellers .card {
      background: #F5F5F5;
    }

    .section-bestsellers .carousel-content slideshow-slides > .card:first-child {
      border-radius: 18px;
    }
  }

  /* Mobile section background */
  @media screen and (max-width: 749px) {
    .shopify-section:has(.section-bestsellers) .section-background {
      background-color: #F5F5F5;
    }
  }

  /* Image area */
  .section-bestsellers .image-block {
    min-height: 186px;
    overflow: hidden;
  }

  .section-bestsellers .image-block__image {
    width: 100%;
    height: 100%;
    min-height: 186px;
    object-fit: contain;
  }

  @media screen and (min-width: 750px) {
    .section-bestsellers .image-block {
      min-height: 257px;
    }

    .section-bestsellers .image-block__image {
      min-height: 257px;
    }

    .section-bestsellers .carousel-content slideshow-slides > .card:first-child .image-block {
      min-height: 282px;
    }

    .section-bestsellers .carousel-content slideshow-slides > .card:first-child .image-block__image {
      min-height: 282px;
    }
  }

  /* Footer */
  .bestsellers__footer {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block-start: 8px;
  }

  .bestsellers__button-wrapper {
    padding-block: 8px;
  }

  .bestsellers__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border: 2px solid currentColor;
    border-radius: 28px;
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 14px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    text-decoration: none;
    color: #000000;
    background: transparent;
    cursor: pointer;
    transition: opacity var(--animation-speed) ease;
  }

  .bestsellers__button:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .bestsellers__button {
      width: 100%;
    }
  }

  @media screen and (min-width: 750px) {
    .bestsellers__button {
      font-size: 16px;
      line-height: 16px;
    }
  }

  .bestsellers__button:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .bestsellers__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.bestsellers",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p><strong>Bestsellers</strong> for cardiovascular support.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        { "value": "arrow", "label": "t:options.arrows" },
        { "value": "chevron", "label": "t:options.chevrons" },
        { "value": "none", "label": "t:options.none" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "circle", "label": "t:options.circle" },
        { "value": "square", "label": "t:options.square" }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:names.bestsellers"
    }
  ]
}
{% endschema %}
